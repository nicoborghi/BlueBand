{% macro data_table(t) -%}
{% if t.title %}<div class="table-title">{{ t.title }}</div>{% endif %}
<table class="data" style="font-size: {{ t.font_size }}pt">
  <colgroup>
    {% for c in t.columns %}<col style="width: {{ c.pct }}%">{% endfor %}
  </colgroup>
  <thead>
    <tr>
      {% for c in t.columns %}<th class="{{ c.align }}{% if c.muted %} mut{% endif %}{% if c.tight %} tight{% endif %}">{{ c.label }}</th>{% endfor %}
    </tr>
  </thead>
  {# one tbody per team / pair / heat side, so print never splits one #}
  {% for block in t.blocks %}
  <tbody{% if t.grouped %} class="keep"{% endif %}>
    {% for row in block %}
      <tr class="{{ row._class|default('') }}">
        {# a band: one line of its own across the sheet (which final these two
           rode, who is champion) instead of the row's cells #}
        {% if row._banner %}
        {% set off = t.banner_offset(row) %}
        {% for c in t.columns[:off] %}<td></td>{% endfor %}
        <td class="l" colspan="{{ t.columns|length - off }}">{{ row._banner }}</td>
        {% else %}
        {# a row may bold single cells of its own (`_bold`: the qualified teams
           on a qualifying sheet), print them red (`_red`: the second rider of
           a madison coppia, who wears the red number) or lay a tint behind one
           (`_tint`: the comunicati already issued, on the programme), on top
           of the columns that are always bold #}
        {% set tint = row._tint|default({}) %}
        {% for c in t.columns %}<td class="{{ c.align }}{% if c.bold or c.key in row._bold|default([]) %} b{% endif %}
          {%- if c.key in row._red|default([]) %} red{% endif %}
          {%- if c.wrap %} wrap{% endif %}{% if c.muted %} mut{% endif %}
          {%- if c.tight %} tight{% endif %}"
          {%- if tint.get(c.key) %} style="background: {{ tint[c.key] }}"{% endif %}>{{ row[c.key]|default('') }}</td>
        {% endfor %}
        {% endif %}
      </tr>
    {% endfor %}
  </tbody>
  {% endfor %}
</table>
{%- endmacro %}

{# One item of a line of slots: whatever Impostazioni sent to that side of the
   sheet, or an empty cell holding the space open. A slot the sheet has nothing
   to put in - a bozza has no number, a reprint no timestamp - prints empty
   too: the two items beside it must not slide across the paper. #}
{% macro slot(item) -%}
{%- if item == "communique" -%}
  {%- if doc.draft %}<span class="bozza">NON DEFINITIVO</span>
  {%- elif doc.communique %}<span class="comunicato">Comunicato n. {{ doc.communique }}
    {%- if doc.pages %} pag. {{ doc.pages }}{% endif %}</span>{% endif -%}
{%- elif item == "printed_at" and printed_at -%}
  <span class="printed-at">{{ printed_at }}</span>
{%- endif -%}
{%- endmacro %}

{# The three slots of one line, left to centre to right - always three cells,
   so the centre one is the centre of the paper and not of what is beside it. #}
{% macro slot_row(items, cls) -%}
<div class="slot-row {{ cls }}">
  {%- for item in items %}<div class="slot">{{ slot(item) }}</div>{% endfor -%}
</div>
{%- endmacro %}

{# The foot of the sheet says only what the letterhead does not - by default
   when the sheet came off the printer, and whatever else the slots were given.
   Competition, venue and title are all in the block above. #}
{% macro footer_block() -%}
<div class="doc-footer">
  {% if foot_line %}<div class="footline"
       {%- if foot_gap %} style="padding-bottom: {{ '%g'|format(foot_gap) }}mm"{% endif %}>
    {{- slot_row(foot_slots, "foot-slots") -}}
  </div>{% endif %}
  {% if footer_img %}<div class="footer-strip"><img src="{{ footer_img }}"
       style="{{ footer_style }}"></div>
  {% endif %}
</div>
{%- endmacro %}

{# One <table class="sheet"> per comunicato: browsers repeat a table's thead
   and tfoot on every printed page, so the letterhead and the footer appear on
   all sheets of a document that runs long - not only on the first one. #}
{# The named page must sit on a wrapper, not on the table itself: with
   `page:` on the table Chrome stops repeating its thead across pages. #}
<div class="sheet-wrap{% if doc.is_landscape %} landscape{% endif %}">
<table class="sheet">
  {# `head=False` (the on-screen preview) prints the table on its own: the app
     page already carries the race and its distances above it. #}
  <thead>
    <tr><td>
      {% if head %}
      <div class="sheet-head">
        {% if banner %}<div class="banner"><img src="{{ banner }}"
             style="{{ banner_style }}"></div>{% endif %}
        <div class="head-body"
             {%- if head_gap %} style="padding-top: {{ '%g'|format(5 + head_gap) }}mm"{% endif %}>
          {# The line under the testata: the comunicato number where the jury
             put it, and whatever else it sent up here. A provisional sheet
             carries no number - it is not one yet, and a number on paper is a
             promise the jury has not made - so the slot prints NON DEFINITIVO
             in its place. #}
          {% if head_line %}
          <div class="comunicato-row">{{ slot_row(head_slots, "head-slots") }}</div>
          {% endif %}
          <div class="title">{{ doc.title }}</div>
          {% if doc.subtitle %}<div class="subtitle">{{ doc.subtitle }}</div>{% endif %}
          {% if doc.info %}<div class="info">{{ doc.info }}</div>{% endif %}
        </div>
      </div>
      {% endif %}
    </td></tr>
  </thead>

  {# The repeated tfoot reserves the footer's height at the bottom of every
     page the table spans; `.page-footer` in page.html.j2 is what actually
     prints there, pinned to the paper edge. See print.css. #}
  <tfoot>
    <tr><td>
      {% if footer %}{{ footer_block() }}{% endif %}
    </td></tr>
  </tfoot>

  <tbody>
    <tr><td>
      <div class="doc">
        {# What the jury wrote, where a composed sheet has its table. Already
           HTML and already escaped: `render.markup` is the only thing that
           builds it, and it reads the box as text before it reads a mark. #}
        {% if doc.body %}<div class="doc-body">{{ doc.body|safe }}</div>{% endif %}
        {% for t in doc.tables %}{{ data_table(t) }}{% endfor %}

        {# the key to the column headings belongs under the table it explains #}
        {% if doc.legend %}<div class="legend">{{ doc.legend }}</div>{% endif %}

        {# The decisions taken in the race, each tinted by what it is, and last
           the sheet's own note in the plain box. See render.Document.blocks. #}
        {# `white-space: pre-line` in the box: the tag and the text stay on one
           line here, or every block would open with a blank one. #}
        {% for b in doc.blocks %}
        <div class="decisione {{ b.kind }}">{% if b.title %}<span class="dec-tag">{{ b.title }}</span> {% endif %}{{ b.text }}</div>
        {% endfor %}

        {# The scanned signature or the typed name, never both and never a
           ruled line: which one is a setting (Impostazioni avanzate). #}
        {% if signature or signature_name %}
        <div class="signature">
          <span class="sig-label">{{ signature_label }}</span>
          {% if signature %}
          <img src="{{ signature }}"{% if signature_style %} style="{{ signature_style }}"{% endif %}>
          {% else %}
          <span class="sig-name">{{ signature_name }}</span>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </td></tr>
  </tbody>
</table>
</div>
