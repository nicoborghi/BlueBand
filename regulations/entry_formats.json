{
  "_last_updated_": "13 August 2026",
  "_about_": "How an entry file is read: one entry per format the federation sends. `ksport` is the flat export of the federal system - one row per rider - and its `columns` are what the sheets this app writes per categoria are headed with. A competition that says nothing about its own layout (`entries:` in programme.yaml) is read with the default one; one that says something wins. Read by core/entry_formats.py.",
  "default": "ksport",
  "formats": {
    "ksport": {
      "name": {
        "it": "Export ksport (federale)",
        "en": "ksport export (federal)"
      },
      "flat": true,
      "header_row": 6,
      "first_data_row": 7,
      "ksport": {
        "DorsaleNumero": "bib",
        "NomeTesserato": "full_name",
        "Cognome": "last_name",
        "Nome": "first_name",
        "CodiceFCI": "fci_code",
        "Categoria": "cat",
        "CodiceUci": "uci_id",
        "Nazionalità": "nation",
        "DataNascita": "birth_date",
        "NomeSocieta": "club",
        "CodiceSocieta": "club_code",
        "Regione": "region",
        "Provincia": "province",
        "Sesso": "sex",
        "Note": "note",
        "Riserva": "reserve_entry",
        "Scadenza Certificato": "certificate_date"
      },
      "columns": {
        "Dors.": "bib",
        "UCI ID": "uci_id",
        "Cognome": "last_name",
        "Nome": "first_name",
        "Naz": "nation",
        "Società": "club",
        "Codice Società": "club_code",
        "Squadra\n(Regione)": "region",
        "Cat.": "cat"
      },
      "check_in": {
        "Verificato": "checked_in",
        "NP": "not_starting"
      }
    },
    "master": {
      "name": {
        "it": "Elenco per categorie (già impaginato)",
        "en": "Workbook with a sheet per category"
      },
      "flat": false,
      "header_row": 1,
      "first_data_row": 2,
      "columns": {
        "Dors.": "bib",
        "UCI ID": "uci_id",
        "Cognome": "last_name",
        "Nome": "first_name",
        "Naz": "nation",
        "Società": "club",
        "Codice Società": "club_code",
        "Squadra\n(Regione)": "region",
        "Cat.": "cat"
      },
      "check_in": {
        "Verificato": "checked_in",
        "NP": "not_starting"
      },
      "_about_": "The workbook this app writes: the header is the first row. The federation's own template carries five empty rows above it - a letterhead nobody reads back - and there is no reason to write them into a file we produce."
    }
  }
}
