msgid "``checks.py``"
msgstr ""

#: ../../reference/index.rst:99 6621d0873d6e463bbec6c2298ae71e6b
msgid ""
"The one implementation of the inline bib flags, and the ``Issue`` shape "
"every validation reports in."
msgstr ""

