msgid "``parse.py``"
msgstr ""

#: ../../reference/index.rst:102 68349cad0c9a4e888b45daf3f28fc8b6
msgid "The jury's shorthand: sprints, heats, bibs, times."
msgstr ""

#: ../../reference/index.rst:103 203a0e3e8afc4800982dc371d1583a0c
msgid "``communiques.py``"
msgstr ""

#: ../../reference/index.rst:104 70ce7a046eaf44e5837243c029554047
msgid "Planning, merge rules, autonumbering, the issued register."
msgstr ""

#: ../../reference/index.rst:105 74e58d37c5e744f9bd88a2e0d1c503c7
msgid "``decisions.py``"
msgstr ""

#: ../../reference/index.rst:106 7a5d6402a79c460e89d383459b1e9134
msgid "The jury's decision log, and the read-only UCI and federal tables."
msgstr ""

#: ../../reference/index.rst:107 485676d359144ce19bcb63073851dc76
msgid "``notes.py``"
msgstr ""

#: ../../reference/index.rst:108 289cbfe539a14e4099211891643da9a4
